# ---------------------------------------------------------------------------
# outline-docs-skill —— 配置模板
# 用法：复制本文件为 outline.env（本目录 / cwd / 或 ~/outline.env 均可），填入真实值。
# outline.env 已在 .gitignore 中，不会被提交。
# 搜索优先级（高 → 低）：
#   1. 进程环境变量
#   2. <cwd>/outline.env 或 <cwd>/.env
#   3. <skill>/outline.env 或 <skill>/.env   ← 本仓库根目录
#   4. ~/outline.env 或 ~/.env
# ---------------------------------------------------------------------------

# 必需 —— Outline 站点地址（不要带尾部斜杠）
OUTLINE_BASE_URL=https://docs.example.com

# 必需 —— 在 Outline「设置 → API Tokens」里生成
OUTLINE_API_KEY=ol_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选 —— 强制指定运行时（python3 / python / uv / node；留空 = 自动探测）
# OUTLINE_RUN_VIA=node

# 可选 —— uv / pycache 的根目录（默认放用户缓存目录，不会落到 skill 内）
# OUTLINE_CACHE_DIR=

# 可选 —— 报错提示里推荐的 pip 镜像
# OUTLINE_PIP_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple

# 可选 —— 自定义本地 markdown 写作模板目录（与内置并存；同名优先）
# OUTLINE_TEMPLATES_DIR=
